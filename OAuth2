package com.HRMS.HRMS.service.OrgChart;

import com.HRMS.HRMS.dto.OrgChart.OrgChartDto;
import com.HRMS.HRMS.entity.Employee;
import com.HRMS.HRMS.exception.ResourceNotFoundException;
import com.HRMS.HRMS.repository.EmployeeRepository;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.extension.ExtendWith;
import org.mockito.InjectMocks;
import org.mockito.Mock;
import org.mockito.Spy;
import org.mockito.junit.jupiter.MockitoExtension;
import org.modelmapper.ModelMapper;

import java.util.ArrayList;
import java.util.List;
import java.util.Optional;

import static org.junit.jupiter.api.Assertions.*;
import static org.mockito.Mockito.*;

// 1. Tell JUnit to use Mockito to handle the @Mock and @InjectMocks annotations
@ExtendWith(MockitoExtension.class)
class OrgChartServiceTest {

    // 2. Mock the repository so we don't hit a real database
    @Mock
    private EmployeeRepository employeeRepository;

    // 3. We use @Spy instead of @Mock for ModelMapper. 
    // This allows the real ModelMapper to convert objects normally, saving us from writing dozens of mock rules for it.
    @Spy
    private ModelMapper modelMapper = new ModelMapper();

    // 4. Inject the mocks into the service we are testing
    @InjectMocks
    private OrgChartService orgChartService;

    private Employee ceo;
    private Employee manager;
    private Employee employee;

    @BeforeEach
    void setUp() {
        // Build a fake company hierarchy before each test runs
        
        ceo = new Employee();
        ceo.setId(1L);
        ceo.setName("CEO John");
        ceo.setEmail("ceo@roima.com");
        ceo.setSubordinates(new ArrayList<>());

        manager = new Employee();
        manager.setId(2L);
        manager.setName("Manager Jane");
        manager.setEmail("jane@roima.com");
        manager.setManager(ceo); // Link to CEO
        manager.setSubordinates(new ArrayList<>());
        ceo.getSubordinates().add(manager);

        employee = new Employee();
        employee.setId(3L);
        employee.setName("Employee Rakesh");
        employee.setEmail("rakesh@roima.com");
        employee.setManager(manager); // Link to Manager
        employee.setSubordinates(new ArrayList<>());
        manager.getSubordinates().add(employee);
    }

    // --- Tests for getOrgChart(Long id) ---

    @Test
    void getOrgChart_WhenEmployeeExists_ReturnsCompleteChart() {
        // Arrange
        when(employeeRepository.findById(3L)).thenReturn(Optional.of(employee));

        // Act
        OrgChartDto result = orgChartService.getOrgChart(3L);

        // Assert
        assertNotNull(result);
        assertEquals("Employee Rakesh", result.getSelectedEmployee().getName());
        
        // Assert Direct Reports (Should be 0 for this leaf employee)
        assertTrue(result.getDirectReports().isEmpty());

        // Assert Path From Root (Should be CEO -> Manager)
        assertEquals(2, result.getPathFromRoot().size());
        assertEquals("CEO John", result.getPathFromRoot().get(0).getName());
        assertEquals("Manager Jane", result.getPathFromRoot().get(1).getName());
    }

    @Test
    void getOrgChart_WhenEmployeeIsCeo_ReturnsChartWithEmptyAncestors() {
        // Arrange
        when(employeeRepository.findById(1L)).thenReturn(Optional.of(ceo));

        // Act
        OrgChartDto result = orgChartService.getOrgChart(1L);

        // Assert
        assertEquals("CEO John", result.getSelectedEmployee().getName());
        
        // CEO has 1 direct report (Jane)
        assertEquals(1, result.getDirectReports().size());
        assertEquals("Manager Jane", result.getDirectReports().get(0).getName());

        // CEO has no manager, so path from root should be completely empty
        assertTrue(result.getPathFromRoot().isEmpty());
    }

    @Test
    void getOrgChart_WhenEmployeeNotFound_ThrowsException() {
        // Arrange
        when(employeeRepository.findById(99L)).thenReturn(Optional.empty());

        // Act & Assert
        assertThrows(ResourceNotFoundException.class, () -> {
            orgChartService.getOrgChart(99L);
        });
        
        // Verify that mapping was never attempted
        verify(modelMapper, never()).map(any(), any());
    }

    // --- Tests for getOrgChartByName(String email) ---

    @Test
    void getOrgChartByName_WhenEmailExists_ReturnsCompleteChart() {
        // Arrange
        when(employeeRepository.findByEmail("jane@roima.com")).thenReturn(Optional.of(manager));

        // Act
        OrgChartDto result = orgChartService.getOrgChartByName("jane@roima.com");

        // Assert
        assertNotNull(result);
        assertEquals("Manager Jane", result.getSelectedEmployee().getName());
        
        // Jane has 1 report (Rakesh)
        assertEquals(1, result.getDirectReports().size());
        assertEquals("Employee Rakesh", result.getDirectReports().get(0).getName());

        // Jane has 1 ancestor (CEO John)
        assertEquals(1, result.getPathFromRoot().size());
        assertEquals("CEO John", result.getPathFromRoot().get(0).getName());
    }

    @Test
    void getOrgChartByName_WhenEmailNotFound_ThrowsException() {
        // Arrange
        when(employeeRepository.findByEmail("unknown@roima.com")).thenReturn(Optional.empty());

        // Act & Assert
        ResourceNotFoundException exception = assertThrows(ResourceNotFoundException.class, () -> {
            orgChartService.getOrgChartByName("unknown@roima.com");
        });
        
        assertEquals("Employee not found", exception.getMessage());
    }
}
package com.HRMS.HRMS.repository.TravelRepositories;

import com.HRMS.HRMS.entity.Employee;
import com.HRMS.HRMS.entity.TravelEntities.ExpenseType;
import com.HRMS.HRMS.entity.TravelEntities.Travel;
import com.HRMS.HRMS.entity.TravelEntities.TravelAssignment;
import com.HRMS.HRMS.entity.TravelEntities.TravelExpense;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Test;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.boot.test.autoconfigure.orm.jpa.DataJpaTest;
import org.springframework.boot.test.autoconfigure.orm.jpa.TestEntityManager;
import org.springframework.test.context.ActiveProfiles;

import java.math.BigDecimal;
import java.time.LocalDate;
import java.time.LocalDateTime;
import java.util.List;

import static org.junit.jupiter.api.Assertions.assertEquals;
import static org.junit.jupiter.api.Assertions.assertNotNull;

// 1. @DataJpaTest disables full auto-configuration and applies only configuration relevant to JPA tests.
@DataJpaTest
@ActiveProfiles("test") // Uses your application-test.properties for H2
public class TravelExpenseRepositoryTest {

    @Autowired
    private TravelExpenseRepository travelExpenseRepository;

    // 2. TestEntityManager is an alternative to standard JPA EntityManager customized for tests.
    // It is great for inserting setup data quickly.
    @Autowired
    private TestEntityManager entityManager;

    private Employee employee;
    private Travel travel;
    private TravelAssignment assignment;
    private ExpenseType foodExpenseType;
    private LocalDate today;

    @BeforeEach
    void setUp() {
        today = LocalDate.now();

        // Step 1: Create and persist foundational entities
        employee = new Employee();
        employee.setName("Rakesh");
        employee.setEmail("rakesh@roima.com");
        entityManager.persist(employee);

        travel = new Travel();
        travel.setDestination("Mumbai");
        entityManager.persist(travel);

        assignment = new TravelAssignment();
        assignment.setEmployee(employee);
        assignment.setTravel(travel);
        entityManager.persist(assignment);

        foodExpenseType = new ExpenseType();
        // Assuming your ExpenseType has a name field
        // foodExpenseType.setName("FOOD"); 
        entityManager.persist(foodExpenseType);

        // Step 2: Create Test Expenses

        // Expense 1: Valid, APPROVED, Food, Today
        TravelExpense expense1 = new TravelExpense();
        expense1.setTravelAssignment(assignment);
        expense1.setExpenseType(foodExpenseType);
        expense1.setDate(today);
        expense1.setAmount(new BigDecimal("500.00"));
        expense1.setStatus("APPROVED"); // Must match your query exactly
        expense1.setCreatedAt(LocalDateTime.now().minusHours(2)); // Older
        entityManager.persist(expense1);

        // Expense 2: Valid, PENDING, Food, Today
        TravelExpense expense2 = new TravelExpense();
        expense2.setTravelAssignment(assignment);
        expense2.setExpenseType(foodExpenseType);
        expense2.setDate(today);
        expense2.setAmount(new BigDecimal("300.00"));
        expense2.setStatus("PENDING");
        expense2.setCreatedAt(LocalDateTime.now().minusHours(1)); // Newer
        entityManager.persist(expense2);

        // Expense 3: REJECTED (Should be ignored by getDailyTotal), Food, Today
        TravelExpense expense3 = new TravelExpense();
        expense3.setTravelAssignment(assignment);
        expense3.setExpenseType(foodExpenseType);
        expense3.setDate(today);
        expense3.setAmount(new BigDecimal("1000.00"));
        expense3.setStatus("REJECTED");
        expense3.setCreatedAt(LocalDateTime.now()); // Newest
        entityManager.persist(expense3);

        // Flush pushes the data to the in-memory database immediately
        entityManager.flush(); 
    }

    // --- Tests for getDailyTotal ---

    @Test
    void getDailyTotal_SumsAmountsExcludingRejected() {
        // Act: We expect it to sum Expense 1 (500) + Expense 2 (300) = 800. 
        // Expense 3 is REJECTED, so it should be ignored.
        BigDecimal dailyTotal = travelExpenseRepository.getDailyTotal(
                employee.getId(), today, foodExpenseType.getId());

        // Assert
        assertEquals(0, new BigDecimal("800.00").compareTo(dailyTotal));
    }

    @Test
    void getDailyTotal_WhenNoRecordsMatch_ReturnsZeroDueToCoalesce() {
        // Act: Query for tomorrow (where no records exist)
        BigDecimal dailyTotal = travelExpenseRepository.getDailyTotal(
                employee.getId(), today.plusDays(1), foodExpenseType.getId());

        // Assert: Your COALESCE(SUM(e.amount), 0) should catch the null and return 0
        assertEquals(0, BigDecimal.ZERO.compareTo(dailyTotal));
    }

    // --- Tests for getTotalApprovedByTravelId ---

    @Test
    void getTotalApprovedByTravelId_SumsOnlyApprovedStatus() {
        // Act: Only Expense 1 is APPROVED (500.00)
        BigDecimal totalApproved = travelExpenseRepository.getTotalApprovedByTravelId(travel.getId());

        // Assert
        assertEquals(0, new BigDecimal("500.00").compareTo(totalApproved));
    }

    // --- Tests for getTotalAmountByAssignmentId ---

    @Test
    void getTotalAmountByAssignmentId_SumsOnlyApprovedStatus() {
        // Act: Only Expense 1 is APPROVED (500.00)
        BigDecimal totalApproved = travelExpenseRepository.getTotalAmountByAssignmentId(assignment.getId());

        // Assert
        assertEquals(0, new BigDecimal("500.00").compareTo(totalApproved));
    }

    // --- Tests for findTravelExpenseByTravelAssignment_IdOrderByCreatedAtDesc ---

    @Test
    void findTravelExpenseByTravelAssignment_IdOrderByCreatedAtDesc_ReturnsCorrectOrder() {
        // Act
        List<TravelExpense> expenses = travelExpenseRepository
                .findTravelExpenseByTravelAssignment_IdOrderByCreatedAtDesc(assignment.getId());

        // Assert
        assertNotNull(expenses);
        assertEquals(3, expenses.size());

        // expense3 was created most recently, so it should be first [0]
        assertEquals("REJECTED", expenses.get(0).getStatus());
        
        // expense2 was created 1 hour ago, so it should be second [1]
        assertEquals("PENDING", expenses.get(1).getStatus());
        
        // expense1 was created 2 hours ago, so it should be last [2]
        assertEquals("APPROVED", expenses.get(2).getStatus());
    }
}
