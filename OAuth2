package com.HRMS.HRMS.Controllers.OrgChart;

import com.HRMS.HRMS.entity.Employee;
import com.HRMS.HRMS.repository.EmployeeRepository;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Test;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.boot.test.autoconfigure.web.servlet.AutoConfigureMockMvc;
import org.springframework.boot.test.context.SpringBootTest;
import org.springframework.http.MediaType;
import org.springframework.test.context.ActiveProfiles;
import org.springframework.test.web.servlet.MockMvc;

import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get;
import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.*;

// 1. Boot up the entire application
@SpringBootTest
// 2. Give us the MockMvc tool to make HTTP requests
@AutoConfigureMockMvc
// 3. Tell Spring to use the "application-test.yml" file we just created
@ActiveProfiles("test")
public class OrgChartControllerIntegrationTest {

    @Autowired
    private MockMvc mockMvc;

    // Notice we inject the REAL repository here, not a mock!
    @Autowired
    private EmployeeRepository employeeRepository;

    @BeforeEach
    public void setupDatabase() {
        // Clear the H2 database before every test to ensure a clean slate
        employeeRepository.deleteAll();

        // Insert real test data into the H2 database
        Employee emp = new Employee();
        emp.setName("Test Employee");
        emp.setEmail("test@roima.com");
        // ... set other necessary fields
        employeeRepository.save(emp);
    }

    @Test
    public void testGetChartByEmail_Integration() throws Exception {
        // Act & Assert
        // This request will go through the Controller -> Service -> Repository -> H2 Database
        mockMvc.perform(get("/org-chart/email/{email}", "test@roima.com")
                .contentType(MediaType.APPLICATION_JSON))
                .andExpect(status().isOk())
                .andExpect(jsonPath("$.message").value("Org chart fetched"))
                // Verify the actual data returned from the H2 database
                .andExpect(jsonPath("$.data.email").value("test@roima.com"));
    }
}
package com.HRMS.HRMS.Controllers.OrgChart;

import com.HRMS.HRMS.dto.OrgChart.OrgChartDto;
import com.HRMS.HRMS.service.Email.EmailService;
import com.HRMS.HRMS.service.OrgChart.OrgChartService;
import org.junit.jupiter.api.Test;
import org.mockito.Mockito;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.boot.test.autoconfigure.web.servlet.WebMvcTest;
import org.springframework.boot.test.mock.mockito.MockBean;
import org.springframework.http.MediaType;
import org.springframework.test.web.servlet.MockMvc;

import static org.mockito.ArgumentMatchers.anyLong;
import static org.mockito.ArgumentMatchers.anyString;
import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get;
import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.*;

// 1. @WebMvcTest loads ONLY the web layer (Controllers, Security), not the whole app/database.
@WebMvcTest(OrgChartController.class)
public class OrgChartControllerTest {

    // 2. MockMvc allows us to simulate HTTP requests without starting a real Tomcat server
    @Autowired
    private MockMvc mockMvc;

    // 3. @MockBean creates fake versions of your services and injects them into the Controller
    @MockBean
    private OrgChartService orgChartService;

    @MockBean
    private EmailService emailService;

    @Test
    public void testGetChartByEmployeeId_ReturnsOk() throws Exception {
        // Arrange: Create dummy data
        Long testId = 1L;
        OrgChartDto mockDto = new OrgChartDto();
        // Assume OrgChartDto has a name field. Set dummy data here:
        // mockDto.setName("Rakesh"); 
        
        // Arrange: Tell the mock service what to return when called
        Mockito.when(orgChartService.getOrgChart(testId)).thenReturn(mockDto);

        // Act & Assert: Perform the GET request and verify the response
        mockMvc.perform(get("/org-chart/id/{employeeId}", testId)
                .contentType(MediaType.APPLICATION_JSON))
                .andExpect(status().isOk()) // Check if HTTP status is 200
                .andExpect(jsonPath("$.message").value("Org chart fetched")) // Check your ApiResponse message
                .andExpect(jsonPath("$.data").exists()); // Check that data is present
    }

    @Test
    public void testGetChartByEmail_ReturnsOk() throws Exception {
        // Arrange
        String testEmail = "test@roima.com";
        OrgChartDto mockDto = new OrgChartDto();
        
        // Tell the mock service to return our mockDto when this specific email is passed
        Mockito.when(orgChartService.getOrgChartByName(testEmail)).thenReturn(mockDto);

        // Act & Assert
        mockMvc.perform(get("/org-chart/email/{email}", testEmail)
                .contentType(MediaType.APPLICATION_JSON))
                .andExpect(status().isOk())
                .andExpect(jsonPath("$.message").value("Org chart fetched"))
                .andExpect(jsonPath("$.data").exists());
    }
}
