import { render, screen, waitFor } from "@testing-library/react";
import userEvent from "@testing-library/user-event";
import { vi } from "vitest";
import { MemoryRouter } from "react-router-dom";
import { QueryClient, QueryClientProvider } from "@tanstack/react-query";

import JobReferrals from "./JobReferrals";
import { useAuthUserContext } from "../../Contexts/AuthUserContext";
import {
  getReferralByJobId,
  getReferralByJobIdAndReferrar,
  updateJobReferralStatus,
} from "../../Services/JobReferralService";

// --- 1. MOCK DEPENDENCIES ---

// Mock React Router to provide a fake jobId in the URL
vi.mock("react-router-dom", async () => {
  const actual = await vi.importActual("react-router-dom");
  return {
    ...actual,
    useParams: () => ({ jobId: "101" }),
  };
});

// Mock the Context
vi.mock("../../Contexts/AuthUserContext", () => ({
  useAuthUserContext: vi.fn(),
}));

// Mock the actual API calls (TanStack Query will call these fakes)
vi.mock("../../Services/JobReferralService", () => ({
  getReferralByJobId: vi.fn(),
  getReferralByJobIdAndReferrar: vi.fn(),
  updateJobReferralStatus: vi.fn(),
}));

vi.mock("react-toastify", () => ({
  toast: { success: vi.fn(), warn: vi.fn() },
}));

// --- 2. THE TEST SUITE ---

describe("JobReferrals Component - TanStack Query Tests", () => {
  let queryClient;
  let invalidateSpy;

  beforeEach(() => {
    vi.clearAllMocks();

    // HOW TO TEST QUERY CLIENT (Step 1):
    // You MUST create a brand new QueryClient for every single test.
    // If you don't, Test A will cache the data, and Test B will instantly pass 
    // without making an API call, causing flaky tests.
    queryClient = new QueryClient({
      defaultOptions: {
        queries: {
          retry: false, // Disable retries so tests fail instantly on error
        },
      },
    });

    // HOW TO TEST QUERY CLIENT (Step 2):
    // We create a "Spy" on the real queryClient's invalidateQueries method.
    // This allows the real method to run, but tracks exactly what it was called with.
    invalidateSpy = vi.spyOn(queryClient, "invalidateQueries");
  });

  // Helper function to wrap our component with the real QueryClient
  const renderComponent = () => {
    return render(
      <QueryClientProvider client={queryClient}>
        <MemoryRouter>
          <JobReferrals />
        </MemoryRouter>
      </QueryClientProvider>
    );
  };

  const mockReferralData = {
    data: [
      {
        id: 1,
        jobTitle: "Java Developer",
        referrerEmail: "hr@roima.com",
        candidateName: "John Doe",
        candidateEmail: "john@example.com",
        note: "Great candidate",
        status: "NEW",
        resumeUrl: "http://resume.com",
      },
    ],
  };

  it("fetches using HR API when user is HR", async () => {
    // Arrange: Set user as HR and mock the HR API response
    useAuthUserContext.mockReturnValue({ authUser: { role: "HR" } });
    getReferralByJobId.mockResolvedValueOnce(mockReferralData);

    // Act
    renderComponent();

    // Assert: Wait for TanStack Query to finish loading and render the data
    expect(await screen.findByText("John Doe")).toBeInTheDocument();
    
    // Verify TanStack Query called the correct API based on the logic
    expect(getReferralByJobId).toHaveBeenCalledWith("101");
    expect(getReferralByJobIdAndReferrar).not.toHaveBeenCalled();
  });

  it("fetches using Employee API when user is not HR", async () => {
    // Arrange: Set user as standard employee
    useAuthUserContext.mockReturnValue({ authUser: { role: "EMPLOYEE" } });
    getReferralByJobIdAndReferrar.mockResolvedValueOnce(mockReferralData);

    renderComponent();

    // Assert
    expect(await screen.findByText("John Doe")).toBeInTheDocument();
    expect(getReferralByJobIdAndReferrar).toHaveBeenCalledWith("101");
    expect(getReferralByJobId).not.toHaveBeenCalled();
  });

  it("MAIN QUERY TEST: invalidates query cache after successful status update", async () => {
    // Arrange: Setup as HR
    useAuthUserContext.mockReturnValue({ authUser: { role: "HR" } });
    getReferralByJobId.mockResolvedValueOnce(mockReferralData);
    updateJobReferralStatus.mockResolvedValueOnce({}); // Mock successful update

    renderComponent();

    // Wait for the list to render
    expect(await screen.findByText("John Doe")).toBeInTheDocument();

    // Act: Click "Change Status" to open the form
    const changeStatusBtn = screen.getByRole("button", { name: /change status/i });
    await userEvent.click(changeStatusBtn);

    // Select a new status from the dropdown
    const select = screen.getByRole("combobox");
    await userEvent.selectOptions(select, "INTERVIEWING");

    // Click submit
    const submitBtn = screen.getByRole("button", { name: /submit/i });
    await userEvent.click(submitBtn);

    // Assert: Wait for the async workflow to complete
    await waitFor(() => {
      // 1. Verify the update API was called with the correct ID and Status
      expect(updateJobReferralStatus).toHaveBeenCalledWith(1, "INTERVIEWING");
      
      // HOW TO TEST QUERY CLIENT (Step 3):
      // Verify that your component successfully told TanStack Query to throw away 
      // the old cache and refetch the specific query key!
      expect(invalidateSpy).toHaveBeenCalledWith({
        queryKey: ["job-referrals", "101"],
      });
    });
  });
});
