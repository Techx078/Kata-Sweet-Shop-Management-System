import { render, screen, waitFor } from "@testing-library/react";
import userEvent from "@testing-library/user-event";
import { vi } from "vitest";
import { MemoryRouter } from "react-router-dom";
import { QueryClient, QueryClientProvider } from "@tanstack/react-query";

// Import the actual component and context
import Login from "./Login";
// NOTE: Make sure your AuthUserContext file exports the raw Context object 
// (e.g., export const AuthUserContext = createContext()) so we can provide our own values.
import { AuthUserContext } from "../../Contexts/AuthUserContext"; 

// Import the services so we can mock them
import { loginUser } from "../../Services/authService";
import { handleGlobalError } from "../../Services/GlobalExceptionService";

// --- 1. MOCKING SERVICES & PARTIAL ROUTER ---

// We mock ONLY useNavigate so we can easily check if it was called, 
// but we keep the rest of react-router-dom intact so <MemoryRouter> works.
const mockNavigate = vi.fn();
vi.mock("react-router-dom", async () => {
  const actual = await vi.importActual("react-router-dom");
  return {
    ...actual,
    useNavigate: () => mockNavigate,
  };
});

vi.mock("../../Services/authService", () => ({
  loginUser: vi.fn(),
}));

vi.mock("../../Services/GlobalExceptionService", () => ({
  handleGlobalError: vi.fn(),
}));

vi.mock("react-toastify", () => ({
  toast: {
    success: vi.fn(),
    error: vi.fn(),
    warn: vi.fn()
  },
}));

vi.mock("../../Componenets/Auth/SendOtp", () => ({
  default: () => <div data-testid="mock-send-otp">Mock Send OTP</div>,
}));

// --- 2. THE TEST SUITE ---

describe("Login Component", () => {
  let queryClient;
  let mockSetAuthUser;

  beforeEach(() => {
    vi.clearAllMocks();
    localStorage.clear();
    
    // Create a fresh QueryClient for each test
    queryClient = new QueryClient({
      defaultOptions: { queries: { retry: false } },
    });
    
    // Create a spy for our Auth Context
    mockSetAuthUser = vi.fn();
  });

  // Helper function to keep our tests clean while manually wrapping
  const renderLogin = () => {
    return render(
      <QueryClientProvider client={queryClient}>
        <AuthUserContext.Provider value={{ authUser: null, setAuthUser: mockSetAuthUser }}>
          <MemoryRouter>
            <Login />
          </MemoryRouter>
        </AuthUserContext.Provider>
      </QueryClientProvider>
    );
  };

  it("renders the login form correctly", () => {
    renderLogin();
    
    expect(screen.getByRole("heading", { name: /login/i })).toBeInTheDocument();
    expect(screen.getByPlaceholderText("Enter Registered Email")).toBeInTheDocument();
    expect(screen.getByPlaceholderText("Enter password")).toBeInTheDocument();
    expect(screen.getByRole("button", { name: "Login" })).toBeInTheDocument();
  });

  it("shows validation errors when submitting empty fields", async () => {
    renderLogin();
    
    const submitButton = screen.getByRole("button", { name: "Login" });
    await userEvent.click(submitButton);

    expect(await screen.findByText("Email is required")).toBeInTheDocument();
    expect(await screen.findByText("Password is required")).toBeInTheDocument();
  });

  it("shows validation error for invalid email format", async () => {
    renderLogin();
    
    const emailInput = screen.getByPlaceholderText("Enter Registered Email");
    await userEvent.type(emailInput, "invalid-email");
    
    const submitButton = screen.getByRole("button", { name: "Login" });
    await userEvent.click(submitButton);

    expect(await screen.findByText("Invalid email format")).toBeInTheDocument();
  });

  it("calls loginUser API and navigates on successful login", async () => {
    const mockResponse = { token: "fake-jwt-token", user: { id: 1, name: "Rakesh" } };
    loginUser.mockResolvedValueOnce(mockResponse);

    renderLogin();
    
    await userEvent.type(screen.getByPlaceholderText("Enter Registered Email"), "rakesh@roima.com");
    await userEvent.type(screen.getByPlaceholderText("Enter password"), "password123");
    
    const submitButton = screen.getByRole("button", { name: "Login" });
    await userEvent.click(submitButton);

    await waitFor(() => {
      // 1. Check if API was called correctly
      expect(loginUser).toHaveBeenCalledWith({
        email: "rakesh@roima.com",
        password: "password123",
      });
      // 2. Check if token was saved
      expect(localStorage.getItem("token")).toBe("fake-jwt-token");
      // 3. Check if our Auth context was updated
      expect(mockSetAuthUser).toHaveBeenCalledWith(mockResponse.user);
      // 4. Check if we navigated to the profile page
      expect(mockNavigate).toHaveBeenCalledWith("/profile/1");
    });
  });

  it("calls handleGlobalError when API fails", async () => {
    const mockError = new Error("Invalid credentials");
    loginUser.mockRejectedValueOnce(mockError);

    renderLogin();
    
    await userEvent.type(screen.getByPlaceholderText("Enter Registered Email"), "rakesh@roima.com");
    await userEvent.type(screen.getByPlaceholderText("Enter password"), "wrongpass");
    await userEvent.click(screen.getByRole("button", { name: "Login" }));

    await waitFor(() => {
      expect(handleGlobalError).toHaveBeenCalledWith(mockError);
    });
  });
});
